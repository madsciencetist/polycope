# Polymarket API hosts (public, no auth required for reads)
POLYCOPE_DATA_API=https://data-api.polymarket.com
POLYCOPE_GAMMA_API=https://gamma-api.polymarket.com

# Local data lake location
POLYCOPE_DATA_DIR=./data

# Politeness / rate-limit controls for ingestion
POLYCOPE_MAX_CONCURRENCY=8
POLYCOPE_REQUEST_TIMEOUT=30
